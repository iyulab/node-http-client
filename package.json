{
  "name": "@iyulab/http-client",
  "version": "0.10.2",
  "description": "A simple HTTP client for handling responses.",
  "keywords": [
    "http",
    "https",
    "api",
    "client",
    "stream",
    "upload"
  ],
  "license": "MIT",
  "author": "iyulab",
  "repository": {
    "type": "git",
    "url": "https://github.com/iyulab/node-http-client.git"
  },
  "files": [
    "dist",
    "skills",
    "package.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "scripts": {
    "preversion": "node -e \"if(require('fs').existsSync('../../scripts/preversion-check.mjs'))require('child_process').execFileSync('node',['../../scripts/preversion-check.mjs'],{stdio:'inherit'})\"",
    "test": "vitest run",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@vitest/expect": "5.0.0",
    "@vitest/ui": "^5.0.0",
    "msw": "^2.15.0",
    "typescript": "^6.0.2",
    "vite": "^8.1.4",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^5.0.0"
  }
}
